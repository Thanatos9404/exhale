# Server-only. Get a key at https://aistudio.google.com/apikey
# Without it, Exhale still runs: plans and chat fall back to the deterministic rules engine.
GEMINI_API_KEY=

# Optional: more Gemini keys (comma separated). Each key x model pair is tried before giving up.
# GEMINI_API_KEYS=key1,key2

# Optional: Claude Haiku as a second provider when every Gemini key and model fails.
# ANTHROPIC_API_KEY=

# Optional: put a specific Gemini model first in the fallback chain. The deployed app sets
# Flash-Lite, the cheapest model that explains a plan well; Flash is then the next candidate.
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------------------------
# Optional: private on-device explanations (Gemini Nano in Chrome through Firebase AI Logic,
# with cloud Gemini through Firebase as the fallback). See docs/HYBRID_AI.md.
# These are PUBLIC client values: Vite puts every VITE_ variable in the browser bundle. A
# Firebase web config is public by design; App Check decides who may use it. Never put a
# server secret (GEMINI_API_KEY, ANTHROPIC_API_KEY) in a VITE_ variable.
# Leave the four required values empty and the feature stays hidden.
# ---------------------------------------------------------------------------------------------

# Required: from Firebase console > Project settings > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Required: the reCAPTCHA site key registered for this web app in Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional: the rest of the web app config.
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional: recaptcha-enterprise (default) or recaptcha-v3, matching the App Check provider.
# VITE_FIREBASE_APPCHECK_PROVIDER=recaptcha-enterprise

# Optional, development only (npm run dev): an App Check debug token registered under
# App Check > Apps > Manage debug tokens. Without it, the SDK prints a new token in the browser
# console. Production builds ignore it. Keep it private and out of Vercel.
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional: cloud model used when Gemini Nano is unavailable (the SDK's hybrid default).
# VITE_FIREBASE_AI_CLOUD_MODEL=gemini-3.5-flash-lite
