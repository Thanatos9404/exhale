# Server-only. Get a key at https://aistudio.google.com/apikey
# Without it, Exhale still runs: plans and chat fall back to the deterministic rules engine.
GEMINI_API_KEY=

# Optional: more Gemini keys (comma separated). Each key x model pair is tried before giving up.
# GEMINI_API_KEYS=key1,key2

# Optional: Claude Haiku as a second provider when every Gemini key and model fails.
# ANTHROPIC_API_KEY=

# Optional: put a specific Gemini model first in the fallback chain.
# GEMINI_MODEL=gemini-3.6-flash
